# Merge this into the repository's .gitmodules, or let `git submodule add`
# write it:
#
#   git submodule add ../qoax-githooks.git .githooks/shared
#
# The url is relative, and git resolves it against the superproject's own
# remote. So a clone over ssh fetches the submodule over ssh and a clone over
# https fetches it over https, without either being wrong for the other, and
# without an absolute url forcing one on everybody. Both are in use.
[submodule ".githooks/shared"]
	path = .githooks/shared
	url = ../qoax-githooks.git
